# PostgreSQL Connection URL (e.g. from Neon)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Secret for signing JWT authentication tokens (any secure random string)
JWT_SECRET=your_super_secret_jwt_key_here

# App/Team Password for user login
APP_PASSWORD=your_team_password_here

# Password required for Admin actions (User management)
ADMIN_PASSWORD=your_admin_password_here
